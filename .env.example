# Tokyo Rent Predictor API - Environment Variables
# Copy this file to .env and update the values as needed

# API Configuration
API_PORT=8000

# MLflow Configuration
# Port 5001 is used to avoid conflict with macOS AirPlay Receiver (port 5000)
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://mlflow:5000
# For local development outside Docker, use:
# MLFLOW_TRACKING_URI=http://localhost:5001

# Database Configuration (if needed in the future)
# DATABASE_URL=postgresql://user:password@localhost:5432/rent_predictor

# Model Configuration
# MODEL_PATH=/app/models
# CHALLENGER_MODEL_NAME=challenger-model.joblib
# PASSED_MODEL_NAME=passed-model.joblib

# Logging
# LOG_LEVEL=INFO

# CORS Origins (comma-separated) — omit to allow all origins (dev only)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Feature Flags (optional)
# ENABLE_MODEL_RETRAINING=true
# ENABLE_METRICS_LOGGING=true
