# PostHog Configuration
# Get your PostHog API key from: https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_your_project_api_key_here

# PostHog Host (optional, defaults to https://app.posthog.com)
# Use this if you're self-hosting PostHog
VITE_POSTHOG_HOST=https://app.posthog.com

# API Configuration (optional)
# VITE_API_BASE_URL=http://localhost:3000
