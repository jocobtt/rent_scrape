# PostHog Configuration
# Get your PostHog API key from: https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_your_project_api_key_here

# PostHog Host (optional, defaults to https://app.posthog.com)
# Use this if you're self-hosting PostHog
VITE_POSTHOG_HOST=https://app.posthog.com

# API Base URL — set in production; dev uses Vite proxy so leave blank locally
VITE_API_BASE_URL=

# Backend port — used by vite.config.js to build the dev proxy target
API_PORT=8000

# Data source URL for the dashboard CSV
# Dev: leave blank to use the static public/tokyo_model.csv
# Prod: set to a CDN URL or backend endpoint, e.g. https://api.example.com/data/listings.csv
VITE_DATA_URL=
